{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "tauri-deepseek-harness",
  "version": "0.1.0",
  "identifier": "com.litongjava.tauri.deepseek.harness",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "连接 DeepSeek Harness",
        "fullscreen": false,
        "resizable": true,
        "height": 440,
        "width": 660,
        "minHeight": 400,
        "minWidth": 520,
        "url": "index.html",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
